{
  "name": "esbvaktin-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for esbvaktin.is",
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "validate": "python3 scripts/validate_export.py",
    "prebuild": "python3 scripts/validate_export.py",
    "build": "rm -rf _site && eleventy && bash tools/minify.sh",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "browser:test": "playwright test",
    "browser:review": "playwright test tests/browser",
    "browser:smoke": "playwright test tests/browser/smoke.spec.js",
    "browser:screens": "playwright test tests/browser/screenshots.spec.js",
    "browser:nav": "playwright test tests/browser/navbar.spec.js",
    "test:unit": "node --test tests/",
    "stats": "node tools/stats.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.48.0"
  }
}
